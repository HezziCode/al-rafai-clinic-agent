# OpenAI API Key (Required)
OPENAI_API_KEY=your-openai-api-key-here

# Google Sheets Configuration (Required)
# ID from your Google Sheet URL: https://docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit
GOOGLE_SHEET_ID=your-google-sheet-id-here
GOOGLE_SERVICE_ACCOUNT_PATH=service_account.json

# Security & CORS Settings
FRONTEND_ORIGIN=http://localhost:3000
ADMIN_API_KEY=carepulse-secret-admin-key-2026

# Twilio WhatsApp Configuration (Optional - falls back to mock console logs if omitted)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
DOCTOR_WHATSAPP_NUMBER=whatsapp:+15551234567

# Clinic Customization (Optional - sensible defaults provided)
CLINIC_NAME=CarePulse Wellness Clinic
CLINIC_DOCTOR_NAME=Dr. Sarah Jenkins
CLINIC_PHONE=+1 (555) 234-5678
CLINIC_ADDRESS=742 Evergreen Terrace, Suite 100
CLINIC_HOURS=1:00 PM – 6:00 PM Daily
