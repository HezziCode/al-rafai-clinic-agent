# Backend API & WebSocket URLs (Defaults to localhost:8000 for development)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Vapi Web Voice Assistant Credentials
NEXT_PUBLIC_VAPI_PUBLIC_KEY=your-vapi-public-key-here
NEXT_PUBLIC_VAPI_ASSISTANT_ID=your-vapi-assistant-id-here

# Doctor Dashboard Admin Key
NEXT_PUBLIC_ADMIN_API_KEY=carepulse-secret-admin-key-2026
